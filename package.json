{
  "name": "smarttech-billing-quotation-sw",
  "productName": "SMART TECH Billing & Quotation",
  "private": true,
  "version": "1.0.0",
  "description": "SMART TECH Interior & Exterior Solutions Billing & Tally Quotation Software",
  "author": "SMART TECH",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/server.js\" \"vite\"",
    "server": "node server/server.js",
    "inspect": "node server/inspectDb.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron electron/main.cjs",
    "desktop:dev": "concurrently -k \"node server/server.js\" \"vite\" \"wait-on tcp:3000 tcp:5000 && electron electron/main.cjs\"",
    "desktop:build": "node scripts/build-desktop.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.6",
    "vite": "^6.1.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.smarttech.billing",
    "productName": "SMART TECH Billing & Quotation",
    "npmRebuild": false,
    "asar": false,
    "directories": {
      "output": "dist_desktop"
    },
    "icon": "electron/icon.png",
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SMART TECH Billing"
    }
  }
}
