# SMART TECH Application Environment Variables

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Set your Authorized JavaScript Origins to: http://localhost:3000 and http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Backend API Server Port (Optional, default 5000)
PORT=5000
